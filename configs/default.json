{
  "dataset_doi": "10.17603/ds2-8yc7-1285",
  "structural_model": "2D steel moment resisting frame, story-wise grouped W-sections",
  "seed": 42,
  "buildings": {
    "train": 435,
    "validation": 93,
    "test": 93
  },
  "ground_motion_record_split": {
    "train": 168,
    "validation": 36,
    "test": 36
  },
  "maximum_stories": 19,
  "design_groups_per_story": 3,
  "geometry_features": 8,
  "continuous_attributes": [
    "log_cross_section_area_m2",
    "log_nominal_depth_m"
